# ── Telegram ───────────────────────────────────────────────────────────
# Get this from @BotFather, then: cp .env.example .env
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Access control (optional but recommended) ──────────────────────────
# Comma-separated chat IDs allowed to run query and delete commands.
# Leave empty to allow any chat. Find your channel id by forwarding a post
# to @userinfobot, or read it from the bot log after the first message.
ALLOWED_CHATS=
